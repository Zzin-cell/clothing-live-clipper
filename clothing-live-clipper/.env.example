# Optional: OpenAI-compatible API for LLM logic planning on ASR transcript
# Flow: local ASR -> LLM keep/order clauses -> reverse cut final.mp4
# If key missing or LLM fails, pipeline auto-falls back to rule ranking.
CLIPPER_LLM_ENABLED=true
CLIPPER_LLM_PLAN=true
CLIPPER_LLM_API_KEY=
CLIPPER_LLM_BASE_URL=https://api.openai.com/v1
CLIPPER_LLM_MODEL=grok-4.5

# Local ASR (recommended): faster-whisper model name or local folder
# GPU (RTX 40xx): medium + float16 + denoise (higher accuracy)
CLIPPER_ASR_DEVICE=cuda
CLIPPER_ASR_COMPUTE_TYPE=float16
CLIPPER_LOCAL_WHISPER_MODEL=
CLIPPER_WHISPER_HUB_MODEL=medium
CLIPPER_ASR_QUALITY=high
# decode quality (higher=better, slower). GPU medium default 5
CLIPPER_ASR_BEAM_SIZE=5
CLIPPER_ASR_BEST_OF=5
# denoise + loudnorm before ASR (1=on)
CLIPPER_ASR_DENOISE=1

# Optional cloud ASR (not required when local whisper works)
CLIPPER_ASR_ENABLED=true
CLIPPER_ASR_PROVIDER=openai_whisper
CLIPPER_ASR_API_KEY=
# OPENAI_API_KEY=
CLIPPER_ASR_BASE_URL=https://api.openai.com/v1
CLIPPER_ASR_MODEL=whisper-1

# ---- GLOBAL product policy (all jobs: Web / CLI / batch / reclip) ----
# Final playback speed (1.3 → ~60s final uses longer source plan)
CLIPPER_PLAYBACK_SPEED=1.4
# First ~20s ONLY clothing features/selling (面料/显瘦/版型…); outfit/change later
CLIPPER_GOLDEN_FEATURES_ONLY=true
CLIPPER_DEMOTE_OUTFIT_FROM_GOLDEN=true
# Never put price/deal talk into final cut
CLIPPER_EXCLUDE_PRICE=true
# Keep clothing-related speech only
CLIPPER_CLOTHING_ONLY=true
