[
  {
    "utt_id": "u0001",
    "text": "家人们晚上好啊，来了扣个1，点点关注。",
    "t0_ms": 0,
    "t1_ms": 4500
  },
  {
    "utt_id": "u0002",
    "text": "先跟大家聊聊天气，今天有点热。",
    "t0_ms": 5000,
    "t1_ms": 9000
  },
  {
    "utt_id": "u0003",
    "text": "看这件，收腰版型特别显瘦，梨形身材闭眼入。",
    "t0_ms": 12000,
    "t1_ms": 18000
  },
  {
    "utt_id": "u0004",
    "text": "面料是凉感醋酸，透气又不起球，夏天穿很舒服。",
    "t0_ms": 18500,
    "t1_ms": 25000
  },
  {
    "utt_id": "u0005",
    "text": "袖口做了小开叉细节，下摆轻微A字更遮胯。",
    "t0_ms": 25500,
    "t1_ms": 32000
  },
  {
    "utt_id": "u0006",
    "text": "通勤约会都能穿，搭牛仔裤或小白鞋都好看。",
    "t0_ms": 32500,
    "t1_ms": 39000
  },
  {
    "utt_id": "u0007",
    "text": "尺码建议按平常码，偏瘦可以试小一码。",
    "t0_ms": 39500,
    "t1_ms": 45000
  },
  {
    "utt_id": "u0008",
    "text": "原价299，券后只要129，链接在上车。",
    "t0_ms": 46000,
    "t1_ms": 52000
  },
  {
    "utt_id": "u0009",
    "text": "好穿到可以闭眼入，库存不多抓紧拍。",
    "t0_ms": 52500,
    "t1_ms": 57500
  },
  {
    "utt_id": "u0010",
    "text": "谢谢老师，左上角关注主播我们下件见。",
    "t0_ms": 58000,
    "t1_ms": 64000
  },
  {
    "utt_id": "u0011",
    "text": "这件垂感很好，穿上立马显瘦10斤那种。",
    "t0_ms": 70000,
    "t1_ms": 76000
  },
  {
    "utt_id": "u0012",
    "text": "颜色有米白和黑色，黑色更显瘦更遮肉。",
    "t0_ms": 76500,
    "t1_ms": 83000
  }
]
